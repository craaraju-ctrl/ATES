#!/bin/bash

# tredo — Autonomous Trading Execution System Wake-up & Daemon script
echo "=== Starting ATES Autonomous Trading Execution System (tredo) ==="

# 1. Start Kronos Forecasting Service in background if not running
if ! curl -s http://localhost:8000/docs > /dev/null; then
    echo "[tredo] Starting Kronos Forecasting Service in background..."
    # Run the fastapi server using python3 in background
    cd kronos_service
    python3 main.py > kronos.log 2>&1 &
    KRONOS_PID=$!
    cd ..
    echo "[tredo] Kronos started with PID: $KRONOS_PID"
    sleep 2 # Let it startup
else
    echo "[tredo] Kronos Forecasting Service is already running."
fi

# 2. Run ATES Autonomous Orchestrator backend
echo "[tredo] Launching ATES Autonomous Orchestrator..."
cargo run -p ates-orchestrator
